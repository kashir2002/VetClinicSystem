@model Pet

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Species" class="form-label"></label>
    <input asp-for="Species" class="form-control" list="species-options" />
    <datalist id="species-options">
        <option value="Cat"></option>
        <option value="Dog"></option>
        <option value="Bird"></option>
        <option value="Rabbit"></option>
        <option value="Hamster"></option>
    </datalist>
    <span asp-validation-for="Species" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Breed" class="form-label"></label>
    <input asp-for="Breed" class="form-control" />
    <span asp-validation-for="Breed" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="BirthDate" class="form-label"></label>
    <input asp-for="BirthDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
    <span asp-validation-for="BirthDate" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="WeightKg" class="form-label"></label>
    <input asp-for="WeightKg" type="number" step="0.1" class="form-control" />
    <span asp-validation-for="WeightKg" class="text-danger"></span>
</div>