@model VaccineRecord
@{
    ViewData["Title"] = "Delete vaccine record";
}

<h1>Delete vaccine record</h1>
<h3>Are you sure you want to delete this record for @Model.Pet?.Name?</h3>
<hr />
<dl class="row">
    <dt class="col-sm-2">Vaccine</dt>
    <dd class="col-sm-10">@Model.VaccineName</dd>

    <dt class="col-sm-2">Date given</dt>
    <dd class="col-sm-10">@Model.DateGiven.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-2">Next dose</dt>
    <dd class="col-sm-10">@(Model.NextDoseDate?.ToString("dd.MM.yyyy") ?? "—")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="Pets" asp-action="Details" asp-route-id="@Model.PetId" class="btn btn-secondary">Back to pet</a>
</form>