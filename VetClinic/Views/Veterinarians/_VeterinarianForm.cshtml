@model VeterinarianFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="FullName" class="form-label"></label>
    <input asp-for="FullName" class="form-control" />
    <span asp-validation-for="FullName" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Phone" class="form-label"></label>
    <input asp-for="Phone" class="form-control" />
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>

<div class="mb-3">
    <label class="form-label fw-bold">Specialties</label>
    @foreach (var s in Model.AllSpecialties)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox"
                   name="SelectedSpecialtyIds" value="@s.Id" id="spec-@s.Id"
                   checked="@Model.SelectedSpecialtyIds.Contains(s.Id)" />
            <label class="form-check-label" for="spec-@s.Id">@s.Name</label>
        </div>
    }
</div>

<div class="mb-3">
    <label class="form-label fw-bold">Services</label>
    @foreach (var s in Model.AllServices)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox"
                   name="SelectedServiceIds" value="@s.Id" id="serv-@s.Id"
                   checked="@Model.SelectedServiceIds.Contains(s.Id)" />
            <label class="form-check-label" for="serv-@s.Id">@s.Name (@s.DurationMinutes min)</label>
        </div>
    }
</div>